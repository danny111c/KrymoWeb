---
---
<section id="solucion" class="py-20 px-6 max-w-7xl mx-auto border-t border-white/[0.08]">
  
  <!-- Encabezado Corto -->
  <div class="text-center max-w-2xl mx-auto mb-12">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
      Adaptado al tamaño de tu tienda
    </h2>
    <p class="mt-3 text-sm text-zinc-400">
      Desde tus primeros perfiles por WhatsApp hasta miles de pantallas activas.
    </p>
  </div>

  <!-- 3 Perfiles Directos al Grano -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
    
    <!-- 1. VENDEDOR SOLO -->
    <div class="rounded-2xl border border-white/10 bg-zinc-950 p-6 flex flex-col justify-between hover:border-white/20 transition">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-bold text-white font-mono">1 Administrador</span>
          <span class="text-[10px] text-zinc-500 uppercase tracking-wider font-mono">Solo</span>
        </div>

        <h3 class="text-lg font-bold text-white mb-4">Vendedor Independiente</h3>

        <ul class="space-y-2.5 text-xs text-zinc-300">
          <li class="flex items-center gap-2">
            <span class="text-white font-bold">✓</span>
            <span>Semáforo de cobro en 0, 2 y 5 días</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-white font-bold">✓</span>
            <span>Entrega de PIN y cuentas en 1 tap</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-white font-bold">✓</span>
            <span>100% optimizado para celular</span>
          </li>
        </ul>
      </div>

      <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-mono">
        <span class="text-zinc-500">Recomendado:</span>
        <span class="text-white font-bold">Plan Individual ($5/m)</span>
      </div>
    </div>

    <!-- 2. CON AYUDANTES (DESTACADO) -->
    <div class="rounded-2xl border border-white/25 bg-zinc-950 p-6 flex flex-col justify-between hover:border-white/40 transition shadow-xl relative">
      <div class="absolute -top-3 right-5 px-2.5 py-0.5 bg-white text-black text-[9px] font-black uppercase tracking-wider rounded-full">
        Popular
      </div>

      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-bold text-white font-mono">1 Admin + 3 Ayudantes</span>
          <span class="text-[10px] text-zinc-400 uppercase tracking-wider font-mono">Equipo</span>
        </div>

        <h3 class="text-lg font-bold text-white mb-4">Tienda con Colaboradores</h3>

        <ul class="space-y-2.5 text-xs text-zinc-200">
          <li class="flex items-center gap-2">
            <span class="text-white font-bold">✓</span>
            <span>Permisos selectivos por empleado</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-white font-bold">✓</span>
            <span>Proveedores y dinero 100% ocultos</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-white font-bold">✓</span>
            <span>Registro de ventas por miembro</span>
          </li>
        </ul>
      </div>

      <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
        <span class="text-zinc-400">Recomendado:</span>
        <span class="text-white font-bold">Plan Equipo ($6.99/m)</span>
      </div>
    </div>

    <!-- 3. MAYORISTA -->
    <div class="rounded-2xl border border-white/10 bg-zinc-950 p-6 flex flex-col justify-between hover:border-white/20 transition">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-bold text-white font-mono">Hasta 8 Ayudantes</span>
          <span class="text-[10px] text-zinc-500 uppercase tracking-wider font-mono">Mayorista</span>
        </div>

        <h3 class="text-lg font-bold text-white mb-4">Agencia y Distribuidores</h3>

        <ul class="space-y-2.5 text-xs text-zinc-300">
          <li class="flex items-center gap-2">
            <span class="text-white font-bold">✓</span>
            <span>Garantías rastreables por proveedor</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-white font-bold">✓</span>
            <span>Pausa matemática en caídas masivas</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-white font-bold">✓</span>
            <span>Migración desde Excel y soporte VIP</span>
          </li>
        </ul>
      </div>

      <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-mono">
        <span class="text-zinc-500">Recomendado:</span>
        <span class="text-white font-bold">Plan Agencia ($10/m)</span>
      </div>
    </div>

  </div>

</section>