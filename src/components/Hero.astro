---
// 1. FRONTMATTER DE ASTRO (Aquí se define la variable)
const services = [
  "Netflix",
  "Spotify",
  "Max",
  "Disney+",
  "IPTV Pro",
  "Prime Video",
  "YouTube Premium",
  "Paramount+",
  "Crunchyroll",
  "Apple TV+",
  "ViX Premium",
  "Tidal"
];
---

<!-- 2. PLANTILLA HTML -->
<section class="relative pt-32 sm:pt-40 pb-20 px-6 max-w-7xl mx-auto text-center overflow-visible">
  
  <!-- ================================================================= -->
  <!-- 1. TEXTO Y BOTONES CENTRADOS                                      -->
  <!-- ================================================================= -->

  <!-- Título H1 Principal -->
<h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white max-w-4xl mx-auto leading-[1.1]">
    La forma más inteligente<br class="hidden sm:inline" />
    de gestionar tus<br class="hidden sm:inline" />ventas de streaming.
  </h1>
  <!-- Subtítulo -->
  <p class="mt-6 text-base sm:text-lg text-zinc-400 max-w-2xl mx-auto font-normal leading-relaxed">
    Olvídate de las hojas de Excel confusas y blocs de notas. Lleva el control de tus ventas en un panel rápido, fácil de usar y pensado para vendedores de streaming.
  </p>

  <!-- Botones de Acción -->
  <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
    <a 
      href="#" 
      data-plan="demo" 
      class="wa-btn w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-full text-xs font-bold uppercase tracking-wider text-black bg-white hover:bg-zinc-200 transition-all shadow-[0_0_25px_rgba(255,255,255,0.25)]"
    >
      Obtener Krymo
    </a>
    <a 
      href="#caracteristicas" 
      class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-full text-xs font-semibold uppercase tracking-wider text-zinc-300 bg-white/[0.04] border border-white/10 hover:bg-white/[0.08] hover:border-white/20 transition"
    >
      Ver Características
    </a>
  </div>

  <!-- ================================================================= -->
  <!-- 2. MOCKUP CON ILUMINACIÓN Y MATRIZ DE PUNTOS                      -->
  <!-- ================================================================= -->
  <div class="mt-14 sm:mt-20 relative max-w-5xl xl:max-w-6xl mx-auto">
    
    <!-- A. RESPLANDOR AMBIENTAL TRASERO -->
    <div class="absolute -top-6 sm:-top-10 -left-2 sm:-left-6 -right-2 sm:-right-6 h-72 sm:h-96 bg-gradient-to-b from-white/30 via-white/10 to-transparent blur-3xl rounded-t-[140px] pointer-events-none -z-10" style="opacity: 0.65;"></div>

    <!-- B. MATRIZ DE PUNTOS -->
    <div 
      class="absolute -top-6 sm:-top-8 -left-4 sm:-left-8 -right-4 sm:-right-8 h-[520px] sm:h-[640px] pointer-events-none -z-10"
      style="
        background-image: radial-gradient(circle, rgba(255, 255, 255, 0.55) 1.2px, transparent 1.2px);
        background-size: 11px 11px;
        mask-image: radial-gradient(ellipse 54% 75% at 50% 10%, black 12%, rgba(0,0,0,0.55) 30%, rgba(0,0,0,0.18) 52%, transparent 72%);
        -webkit-mask-image: radial-gradient(ellipse 54% 75% at 50% 10%, black 12%, rgba(0,0,0,0.55) 30%, rgba(0,0,0,0.18) 52%, transparent 72%);
      "
    ></div>

    <!-- C. LÍNEA DE NEÓN BLANCA -->
    <div 
      class="absolute -top-[1.5px] -left-[1.5px] -right-[1.5px] h-20 rounded-t-2xl sm:rounded-t-3xl border-t-2 border-l-2 border-r-2 border-white pointer-events-none z-20"
      style="
        box-shadow: 0 -4px 18px rgba(255, 255, 255, 0.65), -4px 0 12px rgba(255, 255, 255, 0.45), 4px 0 12px rgba(255, 255, 255, 0.45);
        mask-image: linear-gradient(to bottom, black 0%, black 25%, transparent 100%);
        -webkit-mask-image: linear-gradient(to bottom, black 0%, black 25%, transparent 100%);
      "
    ></div>

    <!-- D. MARCO DEL DASHBOARD -->
    <div class="relative z-10 rounded-2xl sm:rounded-3xl border border-white/10 bg-zinc-950 overflow-hidden shadow-2xl">
      
      <!-- Barra superior estilo software -->
      <div class="h-11 bg-zinc-950 border-b border-white/10 px-5 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
        </div>
        <div class="text-[11px] font-mono text-zinc-500 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          krymo
        </div>
        <div class="flex items-center gap-1.5 text-[10px] text-zinc-400 font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          online
        </div>
      </div>

      <!-- IMAGEN DE TU SISTEMA -->
      <div class="relative w-full bg-black">
        <img 
          src="/img2.png" 
          alt="Panel de Control de Krymo CRM" 
          class="w-full h-auto block object-cover object-top select-none"
        />

        <!-- Desvanecimiento inferior suave hacia el negro -->
        <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-28 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
      </div>

    </div>

  </div>

  <!-- ================================================================= -->
  <!-- 3. CARDS DESLIZABLES RECTANGULARES                                -->
  <!-- ================================================================= -->
  <div class="mt-20 sm:mt-24 pt-12 border-t border-white/[0.08] text-center w-full">
    
    <p class="text-xs uppercase tracking-widest text-zinc-500 font-semibold mb-8">
      Compatible con cualquier formato de cuenta
    </p>

    <!-- Contenedor con máscara de difuminado lateral suave -->
    <div class="relative w-full overflow-hidden marquee-mask">
      
      <!-- Pista continua sin parpadeos -->
      <div class="marquee-track flex gap-4 py-3">
        
        <!-- Primera tanda de tarjetas -->
        {services.map((name) => (
          <div class="px-7 py-4 rounded-2xl border border-white/10 bg-[#16161A] shrink-0 text-sm sm:text-base font-bold text-white tracking-wide shadow-lg flex items-center justify-center min-w-[140px] sm:min-w-[160px] hover:border-white/30 transition">
            {name}
          </div>
        ))}

        <!-- Segunda tanda idéntica para el bucle infinito -->
        {services.map((name) => (
          <div class="px-7 py-4 rounded-2xl border border-white/10 bg-[#16161A] shrink-0 text-sm sm:text-base font-bold text-white tracking-wide shadow-lg flex items-center justify-center min-w-[140px] sm:min-w-[160px] hover:border-white/30 transition">
            {name}
          </div>
        ))}

      </div>

    </div>

  </div>

</section>

<style>
  /* Difuminado suave en los bordes izquierdo y derecho */
  .marquee-mask {
    mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
  }

  /* Pista en movimiento continua sin parpadeo */
  .marquee-track {
    width: max-content;
    animation: scrollRightToLeft 28s linear infinite;
    will-change: transform;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0);
  }

  @keyframes scrollRightToLeft {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>