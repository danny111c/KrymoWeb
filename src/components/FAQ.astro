<section id="faq" class="py-20 px-6 max-w-3xl mx-auto border-t border-white/[0.08]">
  <div class="text-center mb-14">
    <h2 class="text-xs uppercase font-bold tracking-widest text-zinc-500 mb-2">Despeja tus Dudas</h2>
    <p class="text-3xl font-bold tracking-tight text-white">Preguntas Frecuentes</p>
  </div>

  <div class="space-y-3">
    
    <!-- 1. Dispositivos -->
    <div class="faq-item glass-card rounded-xl border border-white/[0.08] transition-colors duration-300">
      <button class="faq-toggle w-full p-5 text-left flex items-center justify-between text-white font-medium text-sm focus:outline-none cursor-pointer">
        <span>¿En qué dispositivos puedo usar Krymo?</span>
        <svg class="w-4 h-4 text-zinc-500 transition-transform duration-300 ease-out faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="faq-wrapper grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out">
        <div class="overflow-hidden">
          <div class="px-5 pb-5 text-xs text-zinc-400 leading-relaxed opacity-0 transition-opacity duration-300 faq-text">
            Puedes instalar Krymo en tu computadora con <strong>Windows</strong>, en tu celular <strong>Android</strong> o acceder directamente desde cualquier <strong>navegador web</strong>. Todo se sincroniza en tiempo real.
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Dónde se guardan los datos -->
    <div class="faq-item glass-card rounded-xl border border-white/[0.08] transition-colors duration-300">
      <button class="faq-toggle w-full p-5 text-left flex items-center justify-between text-white font-medium text-sm focus:outline-none cursor-pointer">
        <span>¿Dónde se guarda mi información?</span>
        <svg class="w-4 h-4 text-zinc-500 transition-transform duration-300 ease-out faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="faq-wrapper grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out">
        <div class="overflow-hidden">
          <div class="px-5 pb-5 text-xs text-zinc-400 leading-relaxed opacity-0 transition-opacity duration-300 faq-text">
            Toda tu información se guarda en tu propia base de datos en la nube (Supabase) bajo tu propiedad y control.
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Facilidad de Instalación -->
    <div class="faq-item glass-card rounded-xl border border-white/[0.08] transition-colors duration-300">
      <button class="faq-toggle w-full p-5 text-left flex items-center justify-between text-white font-medium text-sm focus:outline-none cursor-pointer">
        <span>¿Es difícil de configurar e instalar?</span>
        <svg class="w-4 h-4 text-zinc-500 transition-transform duration-300 ease-out faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="faq-wrapper grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out">
        <div class="overflow-hidden">
          <div class="px-5 pb-5 text-xs text-zinc-400 leading-relaxed opacity-0 transition-opacity duration-300 faq-text">
            No, es muy rápido. Al adquirir tu plan te entregamos un video tutorial paso a paso para conectar tu base de datos y empezar a usar Krymo. Si necesitas ayuda, te guiamos directamente por WhatsApp.
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Vencimiento de Licencia -->
    <div class="faq-item glass-card rounded-xl border border-white/[0.08] transition-colors duration-300">
      <button class="faq-toggle w-full p-5 text-left flex items-center justify-between text-white font-medium text-sm focus:outline-none cursor-pointer">
        <span>¿Qué pasa con mis datos si no renuevo mi mensualidad a tiempo?</span>
        <svg class="w-4 h-4 text-zinc-500 transition-transform duration-300 ease-out faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="faq-wrapper grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out">
        <div class="overflow-hidden">
          <div class="px-5 pb-5 text-xs text-zinc-400 leading-relaxed opacity-0 transition-opacity duration-300 faq-text">
            Al estar almacenados en tu propia base de datos, permanecen intactos. Cuando decidas renovar tu plan en Krymo, simplemente inicias sesión y todo estará exactamente donde lo dejaste.
          </div>
        </div>
      </div>
    </div>

    <!-- 5. Métodos de Pago -->
    <div class="faq-item glass-card rounded-xl border border-white/[0.08] transition-colors duration-300">
      <button class="faq-toggle w-full p-5 text-left flex items-center justify-between text-white font-medium text-sm focus:outline-none cursor-pointer">
        <span>¿Qué métodos de pago aceptan para la suscripción?</span>
        <svg class="w-4 h-4 text-zinc-500 transition-transform duration-300 ease-out faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="faq-wrapper grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out">
        <div class="overflow-hidden">
          <div class="px-5 pb-5 text-xs text-zinc-400 leading-relaxed opacity-0 transition-opacity duration-300 faq-text">
            Aceptamos Binance (USDT) y transferencias bancarias locales (Ecuador).
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- 🚀 SCRIPT FLUIDO CON TRANSICIÓN SUAVE -->
<script>
  function setupFaqAccordion(): void {
    document.querySelectorAll('.faq-toggle').forEach((boton: Element) => {
      boton.addEventListener('click', () => {
        const item = boton.closest('.faq-item');
        if (!item) return;

        const wrapper = item.querySelector('.faq-wrapper') as HTMLElement | null;
        const icon = item.querySelector('.faq-icon') as HTMLElement | null;
        const text = item.querySelector('.faq-text') as HTMLElement | null;

        if (!wrapper || !icon || !text) return;

        const estaAbierto: boolean = wrapper.classList.contains('grid-rows-[1fr]');

        // Cierra los demás items para efecto acordeón limpio
        document.querySelectorAll('.faq-item').forEach((otroItem: Element) => {
          const otroWrapper = otroItem.querySelector('.faq-wrapper');
          const otroIcon = otroItem.querySelector('.faq-icon');
          const otroText = otroItem.querySelector('.faq-text');

          if (otroWrapper && otroIcon && otroText) {
            otroWrapper.classList.remove('grid-rows-[1fr]');
            otroWrapper.classList.add('grid-rows-[0fr]');
            otroIcon.classList.remove('rotate-180', 'text-white');
            otroText.classList.remove('opacity-100');
            otroText.classList.add('opacity-0');
            otroItem.classList.remove('border-white/20');
          }
        });

        // Si estaba cerrado, lo abre suavemente
        if (!estaAbierto) {
          wrapper.classList.remove('grid-rows-[0fr]');
          wrapper.classList.add('grid-rows-[1fr]');
          icon.classList.add('rotate-180', 'text-white');
          text.classList.remove('opacity-0');
          text.classList.add('opacity-100');
          item.classList.add('border-white/20');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFaqAccordion);
  } else {
    setupFaqAccordion();
  }
  document.addEventListener('astro:page-load', setupFaqAccordion);
</script>